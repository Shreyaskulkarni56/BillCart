{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billcart-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "alias": {
    "mongoose": "mongoose/index.js",
    "iconv-lite": "./src/shims/iconv-lite.js"
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "EMAIL_SERVICE": "gmail"
  },
  "secrets": {
    "required": [
      "MONGO_URI",
      "JWT_SECRET",
      "EMAIL_USER",
      "EMAIL_PASS"
    ]
  },
  "observability": {
    "enabled": true
  }
}
